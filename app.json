{
  "expo": {
    "name": "KBiz 360 - Smart Connect",
    "slug": "kbiz360-smart-connect",
    "scheme": "kbiz360",
    "platforms": ["ios", "android"],
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E14"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 10,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": ["*/*"],
          "androidMultiIntentFilters": ["*/*"]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KBiz 360 uses your location to auto check-in / check-out when you are at the office, even in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KBiz 360 uses Face ID as a backup way to punch attendance at the office."
        }
      ],
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KBiz 360 uses the microphone for voice search.",
          "speechRecognitionPermission": "KBiz 360 uses speech recognition so you can search by voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "KBiz 360 needs microphone access to record voice messages in chat."
        }
      ],
      "@config-plugins/react-native-webrtc",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "KBiz 360 saves photos and videos you download from chat into your photo library.",
          "savePhotosPermission": "KBiz 360 saves photos and videos you download from chat into your photo library."
        }
      ],
      "./plugins/withVoipPush",
      "./plugins/withNotifeeRepo"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kingsgroup.kbiz360",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSLocationWhenInUseUsageDescription": "KBiz 360 uses your location to auto check-in / check-out at the office.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KBiz 360 uses your location in the background to auto check-in when you arrive at the office and check out when you leave.",
        "NSFaceIDUsageDescription": "KBiz 360 uses Face ID as a backup way to punch attendance.",
        "NSMicrophoneUsageDescription": "KBiz 360 needs the microphone for voice messages and calls.",
        "NSCameraUsageDescription": "KBiz 360 needs the camera for photos, videos and video calls in chat.",
        "NSPhotoLibraryUsageDescription": "KBiz 360 needs photo access to attach images and files to chats and email.",
        "UIBackgroundModes": [
          "remote-notification",
          "audio",
          "voip",
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.kingsgroup.kbiz360",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0E14"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://kbiz360.duckdns.org",
      "router": {},
      "eas": {
        "projectId": "57cc7a94-1acf-42e3-8697-e7f1a6abae0d"
      },
      "msEmail": {
        "clientId": "c29562fd-8836-420b-afaf-88831a129095",
        "tenantId": "4a760f41-b76c-4477-9142-b8692697769e"
      }
    },
    "owner": "adminkingsgroup",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/57cc7a94-1acf-42e3-8697-e7f1a6abae0d"
    }
  }
}