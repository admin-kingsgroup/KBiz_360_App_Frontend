<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Work Board home-screen widget. The app feeds it through KbizWidgetModule.setSnapshot. -->
    <receiver
      android:name="com.kingsgroup.kbiz360.widget.WorkBoardWidget"
      android:exported="false"
      android:label="@string/kbiz_wb_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/kbiz_wb_info" />
    </receiver>
  </application>
</manifest>
