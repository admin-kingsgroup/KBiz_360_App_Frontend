<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 by default (the medium board); stretch it taller and it becomes the large board with the
     next reminders and unread chats. updatePeriodMillis is only a fallback: the widget also schedules
     its own redraw for each reminder's due time (WorkBoardWidget.scheduleRedraw). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/kbiz_wb_description"
  android:initialLayout="@layout/kbiz_wb_loading"
  android:minWidth="250dp"
  android:minHeight="110dp"
  android:minResizeWidth="220dp"
  android:minResizeHeight="110dp"
  android:previewLayout="@layout/kbiz_wb_preview"
  android:resizeMode="horizontal|vertical"
  android:targetCellWidth="4"
  android:targetCellHeight="2"
  android:updatePeriodMillis="1800000"
  android:widgetCategory="home_screen" />
