<?xml version="1.0" encoding="utf-8"?>
<!-- The Owner's large Work Board (owner, 2026-11-03 voice note on his widget), as OwnerBoardLarge in
     targets/widget/index.swift: no greeting / date / punch row — the four tiles (Reminders with its late
     count, Review, Approvals, Chats with its groups) sit at the top, and every row under them is a
     reminder, as many as the widget's height has room for (ownerLargeRows). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/kbiz_wb_bg"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="@dimen/kbiz_wb_padding">

  <!-- 80dp = OWNER_STATS_DP in WidgetData.kt -->
  <LinearLayout
    android:id="@+id/kbiz_wb_stats"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal" />

  <LinearLayout
    android:id="@+id/kbiz_wb_reminders"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/kbiz_wb_reminders_empty"
    style="@style/KbizWb.Text.Mute"
    android:layout_marginTop="10dp"
    android:text="No reminders waiting for you"
    android:textSize="11.5sp"
    android:visibility="gone" />
</LinearLayout>
