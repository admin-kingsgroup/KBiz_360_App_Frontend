<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/kbiz_wb_bg"
  android:clipToOutline="true"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="@dimen/kbiz_wb_padding">

  <ImageView
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:importantForAccessibility="no"
    android:src="@drawable/kbiz_wb_brand" />

  <TextView
    style="@style/KbizWb.Text.Semi"
    android:layout_marginTop="6dp"
    android:text="KBiz 360"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/kbiz_wb_signed_out_text"
    style="@style/KbizWb.Text.Mute"
    android:layout_marginTop="3dp"
    android:text="Open the app to sign in"
    android:textSize="11sp" />
</LinearLayout>
