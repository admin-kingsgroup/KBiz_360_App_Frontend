<?xml version="1.0" encoding="utf-8"?>
<!-- A reminder: coloured bar (late / today / later), text, who set it, when it is due. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kbiz_wb_rem"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <ImageView
    android:id="@+id/kbiz_wb_rem_bar"
    android:layout_width="3.5dp"
    android:layout_height="26dp"
    android:importantForAccessibility="no" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/kbiz_wb_rem_text"
      style="@style/KbizWb.Text.Semi"
      android:layout_width="match_parent"
      android:textSize="12.5sp" />

    <TextView
      android:id="@+id/kbiz_wb_rem_by"
      style="@style/KbizWb.Text.Mute"
      android:layout_width="match_parent"
      android:layout_marginTop="2dp"
      android:textSize="10sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/kbiz_wb_rem_due"
    style="@style/KbizWb.Text.Semi"
    android:layout_marginStart="6dp"
    android:textSize="10.5sp" />
</LinearLayout>
